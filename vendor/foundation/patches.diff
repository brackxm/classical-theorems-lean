+# Modified for ClassicalTheorems on 2026-10-03: selected import closure, shared pinned mathlib.
 name = "Foundation"
+version = "0.1.0"
 defaultTargets = ["Foundation"]
-platformIndependent = true
 
-# Mathlib's own options: `autoImplicit` off, and the standard linter set that downstream
-# projects are meant to opt into wholesale (see `register_linter_set linter.mathlibStandardSet`
-# in `Mathlib/Init.lean`), which subsumes the individual linters this file used to list (and
-# `weak.linter.refine` was not even a registered option, so it had never run). Only the header
-# linter is dropped: it enforces Mathlib's copyright header, which this repository does not
-# carry. `lake build --wfail`, which CI uses, turns every warning the set emits into an error.
-[leanOptions]
-pp.unicode.fun = true
-autoImplicit = false
-weak.linter.mathlibStandardSet = true
-weak.linter.style.header = false
+[[require]]
+name = "mathlib"
+git = "https://github.com/leanprover-community/mathlib4.git"
+rev = "1e043bcd56469cb8cf2bdcddfd3c943dd691ad6d"
 
 [[lean_lib]]
 name = "Foundation"
-
